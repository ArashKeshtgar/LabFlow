table 'Copy Runs'
	lineageTag: 090c47bb-3a6e-4a8f-8739-e86ed72c8b36

	/// Fact rows inserted or updated in Azure by the ADF pipeline.
	measure 'Facts Copied To Azure' = SUM ( 'Copy Runs'[FactsInserted] ) + SUM ( 'Copy Runs'[FactsUpdated] )
