model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Server", "Database", "Results", "Test", "Payer", "Patient", "Date", "Load Runs", "Data Quality Issues", "Copy Runs"]

ref table Results
ref table Test
ref table Payer
ref table Patient
ref table Date
ref table 'Load Runs'
ref table 'Data Quality Issues'
ref table 'Copy Runs'
