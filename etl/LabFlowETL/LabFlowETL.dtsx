      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{84257F0B-BF5C-47A4-8D27-BD96E3977FB0}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="RunId">
      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9790B903-5210-4F07-9D1B-B84D73ABE24B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT r.FishNo AS LegacyVisitNo, r.Az_ID AS LegacyAzId, r.ChildAz_ID AS LegacyChildAzId, r.[Row] AS RowNo, r.Row2 AS RowNo2, CAST(r.Answer1 AS nvarchar(250)) AS Answer, CAST(r.Unit AS nvarchar(15)) AS Unit, CAST(r.NormalRange AS nvarchar(200)) AS NormalRange, r.OutOfNormalRange AS OutOfRange, r.OutOfCriticalNormalRange AS OutOfCritical, CAST(r.NoAnswer AS nvarchar(1)) AS NoAnswer FROM dbo.MRJAZ r WHERE r.FishNo &gt; &quot; + (DT_WSTR, 12) @[User::FromVisitNo]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlResults">
      <DTS:VariableValue
        DTS:DataType="8">SELECT r.FishNo AS LegacyVisitNo, r.Az_ID AS LegacyAzId, r.ChildAz_ID AS LegacyChildAzId, r.[Row] AS RowNo, r.Row2 AS RowNo2, CAST(r.Answer1 AS nvarchar(250)) AS Answer, CAST(r.Unit AS nvarchar(15)) AS Unit, CAST(r.NormalRange AS nvarchar(200)) AS NormalRange, r.OutOfNormalRange AS OutOfRange, r.OutOfCriticalNormalRange AS OutOfCritical, CAST(r.NoAnswer AS nvarchar(1)) AS NoAnswer FROM dbo.MRJAZ r WHERE r.FishNo &gt; 0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AFCB9F81-492E-4EB6-8433-94EF0BF7B0EC}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT m.FishNo AS LegacyVisitNo, CAST(CONVERT(char(64), HASHBYTES('SHA2_256', CONCAT('&quot; + @[User::HashSalt] + &quot;', '|', m.PRV_Code)), 2) AS nchar(16)) AS PatientHash, p.Sex AS LegacySex, m.Age, m.AgeKind, CAST(m.[Date] AS nvarchar(10)) AS VisitDateJ, CAST(m.[Time] AS nvarchar(8)) AS VisitTime, CAST(m.AnsDate AS nvarchar(10)) AS AnswerDateJ, CAST(m.AnsTime AS nvarchar(8)) AS AnswerTime, m.Bime_ID AS LegacyPayerId, m.Cancel AS Cancelled, m.PregnancyWeek FROM dbo.MRJ m LEFT JOIN dbo.PRV p ON p.Code = m.PRV_Code WHERE m.FishNo &gt; &quot; + (DT_WSTR, 12) @[User::FromVisitNo]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlVisits">
      <DTS:VariableValue
        DTS:DataType="8">SELECT m.FishNo AS LegacyVisitNo, CAST(CONVERT(char(64), HASHBYTES('SHA2_256', CONCAT('', '|', m.PRV_Code)), 2) AS nchar(16)) AS PatientHash, p.Sex AS LegacySex, m.Age, m.AgeKind, CAST(m.[Date] AS nvarchar(10)) AS VisitDateJ, CAST(m.[Time] AS nvarchar(8)) AS VisitTime, CAST(m.AnsDate AS nvarchar(10)) AS AnswerDateJ, CAST(m.AnsTime AS nvarchar(8)) AS AnswerTime, m.Bime_ID AS LegacyPayerId, m.Cancel AS Cancelled, m.PregnancyWeek FROM dbo.MRJ m LEFT JOIN dbo.PRV p ON p.Code = m.PRV_Code WHERE m.FishNo &gt; 0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
